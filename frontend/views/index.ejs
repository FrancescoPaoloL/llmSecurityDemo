<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>OWASP LLM Security Demo</h1>
            <p class="subtitle">Test LLM vulnerabilities based on OWASP Top 10</p>
        </header>
        <main>
            <div class="input-section">
                <label for="prompt">Enter your test prompt:</label>
                <textarea id="prompt" rows="8"></textarea>
                <script>
                    const placeholderText = `Enter your prompt or try one of our sample attacks from the buttons below.`;
                    document.getElementById('prompt').placeholder = placeholderText;
                </script>
                <button id="testBtn" class="btn-primary">
                    Test Vulnerability
                </button>
            </div>
            <div id="loading" class="loading" style="display: none;">
                <div class="spinner"></div>
                <p>Analyzing prompt... (~20 seconds)</p>
            </div>
            <div id="results" class="results" style="display: none;">
                <h2>Results</h2>
                <div class="result-section">
                    <h3>Category</h3>
                    <div id="category" class="category-badge"></div>
                </div>
                <div class="result-section">
                    <h3>Model Response</h3>
                    <div id="response" class="response-text"></div>
                </div>
                <div class="result-section">
                    <h3>Metadata</h3>
                    <div id="metadata" class="metadata"></div>
                </div>
            </div>
            <div id="error" class="error" style="display: none;">
                <h3>Error!!!</h3>
                <p id="errorMsg"></p>
            </div>
        </main>
        <section class="plugin-demo">
            <h2>Plugin Demo (LLM07)</h2>
            <div class="plugin-controls">
                <label for="pluginQuery">SQL Query:</label>
                <textarea id="pluginQuery" rows="3"></textarea>
                <div class="plugin-buttons">
                    <button id="runUnsafe" class="btn-danger">Run Unsafe</button>
                    <button id="runSafe" class="btn-safe">Run Safe</button>
                </div>
                <div class="plugin-examples">
                    <span onclick="loadPluginExample('LLM01')">LLM01: Injection via plugin</span>
                    <span onclick="loadPluginExample('LLM02')">LLM02: SQL via output</span>
                    <span onclick="loadPluginExample('LLM07')">LLM07: UNION bypass</span>
                </div>
            </div>
            <div id="pluginResults" class="plugin-results" style="display: none;">
                <div id="pluginWarning" class="plugin-warning" style="display: none;"></div>
                <div id="pluginTable" class="plugin-table"></div>
            </div>
        </section>
        <footer>
            <p>Educational project - OWASP LLM Top 10 Implementation</p>
            <p class="categories">
                <span onclick="loadExample('LLM01')">LLM01: Prompt Injection</span>
                <span onclick="loadExample('LLM02')">LLM02: Insecure Output</span>
                <span onclick="loadExample('LLM03')">LLM03: Training Data Poisoning</span>
                <span onclick="loadExample('LLM04')">LLM04: Model DoS</span>
                <span onclick="loadExample('LLM06')">LLM06: Info Disclosure</span>
                <span onclick="loadExample('LLM05')">LLM05: Supply Chain</span>
            </p>
        </footer>
    </div>
    <script src="/js/form-handler.js"></script>
    <%- include('partials/footer', { frontendVersion: '0.10.3' }) %>
</body>
</html>
